# Copy this file to .env and fill it in. NEVER commit .env and never paste keys in chat.

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model ids come from: python backend/scripts/check_gemini.py
GEMINI_GEN_MODEL=
GEMINI_EMBED_MODEL=

# Local development database (SQLite file created in the folder you run the backend from)
DATABASE_URL=sqlite:///./firaza.db
# Neon Postgres connection string (used for seeding the production DB and on Render)
PROD_DATABASE_URL=

# Where the Streamlit frontend finds the backend
BACKEND_URL=http://localhost:8000
